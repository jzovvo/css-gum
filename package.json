{
  "name": "css-gum",
  "version": "0.0.2",
  "description": "A flexible CSS unit conversion utility for responsive design with viewport units (vw, vh)",
  "type": "module",
  "author": {
    "name": "jzovvo",
    "email": "jzovvo@gmail.com",
    "url": "https://jzovvo.dev/"
  },
  "maintainers": [
    {
      "name": "jzovvo",
      "email": "jzovvo@gmail.com",
      "url": "https://jzovvo.dev/"
    }
  ],
  "contributors": [
    {
      "name": "jzovvo",
      "email": "jzovvo@gmail.com",
      "url": "https://jzovvo.dev/"
    }
  ],
  "license": "MIT",
  "keywords": [
    "css",
    "viewport",
    "vw",
    "vh",
    "px-to-vw",
    "px-to-vh",
    "responsive",
    "design-draft scaling",
    "css-units",
    "rwd"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jzovvo/css-gum"
  },
  "bugs": {
    "url": "https://github.com/jzovvo/css-gum/issues"
  },
  "homepage": "https://github.com/jzovvo/css-gum#readme",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@stylistic/eslint-plugin": "^5.2.3",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9.33.0",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{json,md}\" && lint:fix",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run lint && npm run test:run && npm run build",
    "prepare": "husky"
  }
}
