{
  "name": "css-gum",
  "version": "1.0.0",
  "description": "Make your responsive designs stretch like gum – seamlessly elastic across all screen sizes. This toolkit transforms complex viewport calculations into simple, intuitive functions, and automatically generates VSCode snippets, allowing you to effortlessly integrate efficient responsive workflows.",
  "type": "module",
  "author": {
    "name": "jzovvo",
    "email": "jzovvo@gmail.com",
    "url": "https://jzovvo.dev/"
  },
  "maintainers": [
    {
      "name": "jzovvo",
      "email": "jzovvo@gmail.com",
      "url": "https://jzovvo.dev/"
    }
  ],
  "contributors": [
    {
      "name": "jzovvo",
      "email": "jzovvo@gmail.com",
      "url": "https://jzovvo.dev/"
    }
  ],
  "license": "MIT",
  "keywords": [
    "css",
    "viewport",
    "vw",
    "vh",
    "px-to-vw",
    "px-to-vh",
    "responsive",
    "design-draft scaling",
    "css-units",
    "rwd"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jzovvo/css-gum"
  },
  "bugs": {
    "url": "https://github.com/jzovvo/css-gum/issues"
  },
  "homepage": "https://github.com/jzovvo/css-gum#readme",
  "funding": {
    "type": "individual",
    "url": "https://ko-fi.com/jzovvo"
  },
  "main": "./dist/index.browser.cjs",
  "module": "./dist/index.browser.js",
  "types": "./dist/index.browser.d.ts",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/index.browser.d.ts",
        "import": "./dist/index.browser.js",
        "require": "./dist/index.browser.cjs"
      },
      "node": {
        "types": "./dist/index.node.d.ts",
        "import": "./dist/index.node.js",
        "require": "./dist/index.node.cjs"
      },
      "default": {
        "types": "./dist/index.browser.d.ts",
        "import": "./dist/index.browser.js",
        "require": "./dist/index.browser.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "zod": "^4.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@stylistic/eslint-plugin": "^5.2.3",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9.34.0",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{json,md}\" && npm run lint:fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run release:check",
    "prepare": "husky",
    "release:patch": "npm version patch && git push origin master --tags",
    "release:minor": "npm version minor && git push origin master --tags",
    "release:major": "npm version major && git push origin master --tags",
    "release:check": "npm run lint && npm run typecheck && npm run test:coverage && npm run build"
  }
}
